# Copy this file to .env and fill in the values
DB_URL=jdbc:mysql://mysql:3306/cardservice?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=cardservice
DB_PASSWORD=cardservice

# Must be at least 32 characters
JWT_SECRET=change-me-please-use-a-strong-32byte-secret-key!!
JWT_EXPIRATION_MS=3600000

# Must be at least 32 characters
CARD_HMAC_KEY=change-me-please-use-a-strong-32byte-hmac-key!!!

SEED_USERNAME=admin
SEED_PASSWORD=ChangeMe!2026

# Set to true to reject card numbers that fail the Luhn checksum (disabled by default)
CARD_VALIDATION_LUHN_ENABLED=false
